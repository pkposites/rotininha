# Gere valores reais com: node scripts/gen-vapid.mjs
CODE_PEPPER=troque
PUSH_SEAL_KEY=troque
VAPID_PUBLIC_KEY=troque
VAPID_PRIVATE_KEY=troque
VAPID_SUBJECT=mailto:dev@example.com
ALLOW_DEV_SIGNUP=true
ALLOWED_ORIGIN=http://localhost:4173
# Mercado Pago (credenciais de TESTE do painel de desenvolvedores) e e-mail
MP_ACCESS_TOKEN=TEST-xxxxxxxx
MP_WEBHOOK_SECRET=segredo-do-webhook-do-painel
MP_API_BASE=http://localhost:19877   # produção: remova (usa https://api.mercadopago.com)
PUBLIC_API_URL=http://localhost:8787
APP_URL=http://localhost:4173
EMAIL_PROVIDER=dev                    # produção: resend (+ RESEND_API_KEY, EMAIL_FROM)
SUPPORT_EMAIL=suporte@exemplo.com.br
PAYMENTS_ENABLED=true
ADMIN_TOKEN=gere-um-token-longo-aleatorio   # >= 24 caracteres; ausente desliga /v1/admin
# API de Conversões da Meta (opcional; só envia com consentimento do comprador)
META_PIXEL_ID=
META_CAPI_TOKEN=
# META_TEST_EVENT_CODE=TEST12345   # para eventos de teste
